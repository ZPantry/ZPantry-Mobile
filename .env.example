EXPO_PUBLIC_API_BASE_URL=https://zpantry-java-backend.onrender.com
EXPO_PUBLIC_ANDROID_API_BASE_URL=https://zpantry-java-backend.onrender.com
EXPO_PUBLIC_AUTH_REDIRECT_URI=
# Google Web client ID is required on web AND native (ID-token audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID enables the callback scheme in app.config.js.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Register Android package + signing SHA-1 in Google Cloud; SDK uses the Web ID.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional: reset-specific OTP verification endpoint (must not consume the OTP).
# Leave blank until the backend exposes it; registration /verify-otp is different.
EXPO_PUBLIC_RESET_OTP_VERIFY_PATH=

# Payment checkout is created by the backend through PayOS.
# Do not put PayOS Client ID, API Key, or Checksum Key in this app.
