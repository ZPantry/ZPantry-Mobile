{
  "expo": {
    "name": "Z-Pantry",
    "slug": "z-pantry-ai-meal-planner",
    "version": "1.0.0",
    "scheme": "zpantry",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zpantry.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Z-Pantry cần quyền truy cập thư viện ảnh để tải ảnh công thức và nguyên liệu.",
          "cameraPermission": "Z-Pantry cần quyền camera để chụp ảnh công thức và nguyên liệu.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f37a60ff-1cad-4dd5-8de1-3007e4ba553d"
      }
    }
  }
}
